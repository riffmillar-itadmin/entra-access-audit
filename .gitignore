# ---------------------------------------------------------------------------
#  Reports and snapshots name real accounts, guests and apps. Keep them out.
# ---------------------------------------------------------------------------
Reports/
entra-access-audit-*
*.snapshot.json
#  ...except the fictional Westmark tenant the tests use.
!tests/fixtures/*.snapshot.json

#  Your own thresholds and break-glass accounts. Wildcards, so a copy
#  ("EntraAccessAudit.local - Copy.psd1") is covered too; the shipped example
#  is a different name and stays tracked.
EntraAccessAudit.local*.psd1

#  Personal copies of instructions, such as CLAUDE.local.md.
*.local*.md

#  Power BI Desktop writes the data it loaded into the project's .pbi cache and
#  local paths into its settings. A .pbix holds data too, and a .pbit can hold
#  your report folder: the template goes on the Release, not in the repo.
**/.pbi/localSettings.json
**/.pbi/cache.abf
*.pbix
*.pbit

#  The module tools/Build-Module.ps1 builds for the PowerShell Gallery.
out/

# ---- editor and OS scratch ----
*.bak
*.tmp
*~
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
