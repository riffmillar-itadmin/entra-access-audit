model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["ReportFolder","StaleDays","TrendDays","Reports","Runs","Results","Findings","Datasets"]

annotation PBI_ProTooling = ["DevMode"]

ref table Runs
ref table Results
ref table Findings
ref table Datasets

ref cultureInfo en-US

